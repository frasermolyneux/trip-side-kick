{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run MX.TripSideKick.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/src/MX.TripSideKick.Web/bin/Debug/net10.0/MX.TripSideKick.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MX.TripSideKick.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Attach to .NET process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
