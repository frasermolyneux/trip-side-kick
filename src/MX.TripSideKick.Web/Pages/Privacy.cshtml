@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy";
    ViewData["Description"] = "How Trip Side Kick handles your data.";
}

<section class="prose">
    <h1>Privacy</h1>
    <p>
        Trip Side Kick is a personal project. Trip content you enter is stored so the application can
        show it back to you and to the people you share a trip with.
    </p>
    <p>
        Diagnostic telemetry is collected to keep the service healthy. Telemetry deliberately excludes
        trip content, documents, booking references and email addresses.
    </p>
    <p>
        Accounts are not yet available. This page will be expanded when sign-in is enabled.
    </p>
</section>
